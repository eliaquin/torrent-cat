{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorrentCat",
  "version": "0.1.0",
  "identifier": "com.eliaquin.torrentcat.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "transparent": true,
        "title": "TorrentCat",
        "width": 1120,
        "height": 780,
        "minWidth": 660,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 21 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "category": "Entertainment",
    "shortDescription": "Stream torrents while they download",
    "macOS": { "minimumSystemVersion": "13.0", "infoPlist": "Info.plist" },
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["magnet", "stream-magnet"] } }
  }
}
